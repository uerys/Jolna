DATABASE_URL=mysql://root:password@localhost:3306/appdb
JWT_SECRET=dev-secret
DISABLE_SCHEDULER=false # Set to true to disable in-memory scheduler in favor of system cron

# PM2 webhook deploy automation
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=9000
DEPLOY_BRANCH=main
RUN_MIGRATIONS=1
RUN_SEED=0
NPM_INSTALL_COMMAND=npm install --include=dev

# Telegram deploy notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Firebase Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Admin Service Account (Backend)
# Path to service account JSON file (for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Raw JSON string of service account file (for CI/CD production environment variable)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-username@gmail.com
SMTP_PASS=your-google-app-password
